# ==============================================================================
# FASHION STORE BACKEND - ENVIRONMENT VARIABLES EXAMPLE
# Copy to your environment / server config for production deployment.
# On local development, application.properties provides safe defaults so
# start_all.bat works out of the box without manual setup.
# ==============================================================================

DB_URL=jdbc:sqlserver://localhost:1433;databaseName=FashionStoreDB;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=your_strong_sql_password_here

JWT_SECRET=replace_with_a_64_char_random_secret_key_for_production_jwt_signing
JWT_EXPIRATION_MS=86400000
