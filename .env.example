# ==============================================================================
# FASHION STORE - DOCKER COMPOSE ENVIRONMENT VARIABLES
# Sao chép file này thành .env ở thư mục gốc trước khi chạy:
#   cp .env.example .env
# ==============================================================================

# Mật khẩu SA của SQL Server (bắt buộc >= 8 ký tự, gồm chữ hoa, chữ thường, số & ký tự đặc biệt)
SA_PASSWORD=FashionStore@2026!

# Khóa bí mật ký JWT (nên đặt chuỗi ngẫu nhiên >= 64 ký tự khi deploy production)
JWT_SECRET=FashionStoreProdSecretKey2026ChangeMeTo64RandomChars998877665544
JWT_EXPIRATION_MS=86400000

# Gemini AI Chat Assistant (tùy chọn - để trống sẽ dùng bộ tư vấn rule-based mặc định)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Danh sách domain được phép gọi API (ngăn cách bằng dấu phẩy)
CORS_ALLOWED_ORIGINS=http://localhost:8088,http://localhost,https://yourdomain.com

# Cổng public của Frontend Nginx (đổi thành 80 khi chạy production trên VPS)
FRONTEND_PORT=8088

# Cổng map SQL Server ra máy host (tránh trùng cổng 1433 nếu máy đã cài SQL Server local)
MSSQL_PORT=14333
