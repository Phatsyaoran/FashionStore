# ==============================================================================
# FASHION STORE FRONTEND - ENVIRONMENT VARIABLES (Vercel / Local)
# ==============================================================================
# Khi deploy lên Vercel, vào Project Settings -> Environment Variables và thêm:
#   VITE_API_BASE_URL = https://<ten-service-backend>.onrender.com/api
#
